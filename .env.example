# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Postgres connection
# Direct connection: migrations / drizzle-kit
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Pooled connection: Next.js runtime
DATABASE_POOL_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# App URL
# Local: http://localhost:3000
# Production: https://YOUR_VERCEL_PROJECT.vercel.app or custom domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lark ops alerts. Leave empty in local dev to log alerts to stdout.
LARK_WEBHOOK_URL_OPS=
LARK_WEBHOOK_TIMEOUT_MS=5000

# Budget thresholds (%)
BUDGET_SOFT_THRESHOLD_PCT=80
BUDGET_HARD_THRESHOLD_PCT=100

# LLM provider
# Current stable value: mock
# Switch to anthropic only after the Anthropic provider implementation is merged.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_INPUT_USD_PER_1M=3
ANTHROPIC_OUTPUT_USD_PER_1M=15
ANTHROPIC_WEB_SEARCH_MAX_USES=3
ANTHROPIC_WEB_SEARCH_USD_PER_1K=10

# Optional future local LLM endpoint, not currently wired.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3
