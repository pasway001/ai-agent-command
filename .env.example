# Minimum-cost mode: local Postgres + local one-user auth + Claude only.
AUTH_PROVIDER=local
APP_AUTH_EMAIL=admin@example.com
APP_AUTH_PASSWORD=change-me
APP_AUTH_NAME=Pathway Admin
APP_LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
APP_SESSION_SECRET=change-me-to-32-chars-or-more-random

# Postgres connection. For minimum-cost production, run Postgres on the Mac mini.
DATABASE_URL=postgresql://pathway:pathway@localhost:5432/pathway
# Optional pooled connection for hosted Postgres/Supabase.
DATABASE_POOL_URL=

# Optional Supabase Auth mode. Required only when AUTH_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL
# Local: http://localhost:3000
# Production: https://YOUR_VERCEL_PROJECT.vercel.app or custom domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Lark ops alerts. Leave empty in local dev to log alerts to stdout.
LARK_WEBHOOK_URL_OPS=
LARK_WEBHOOK_TIMEOUT_MS=5000

# Budget thresholds (%)
BUDGET_SOFT_THRESHOLD_PCT=80
BUDGET_HARD_THRESHOLD_PCT=100

# LLM provider. Use mock for zero-cost dry runs, anthropic for production scoring.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_INPUT_USD_PER_1M=3
ANTHROPIC_OUTPUT_USD_PER_1M=15
# Web search for research stage (scout-perplexity). Scoring never requests webSearch so stays deterministic.
ANTHROPIC_ENABLE_WEB_SEARCH=1
ANTHROPIC_WEB_SEARCH_MAX_USES=5
ANTHROPIC_WEB_SEARCH_USD_PER_1K=10
SCOUT_RESEARCH_WEB_SEARCH_MAX_USES=8
# Deep research for high-scoring products (score >= threshold). Uses Sonnet + 10 web searches.
SCOUT_DEEP_RESEARCH_THRESHOLD=0.75
SCOUT_DEEP_RESEARCH_WEB_SEARCH_MAX_USES=10

# Perplexity API (optional future upgrade). System currently uses Claude Haiku + web_search instead.
# Perplexity — used by scout.perplexity_jp_market for Japan market research.
# sonar-pro includes web search in the price; no additional per-search fee.
# Without this key the agent auto-degrades to mock (safe for local dev).
PERPLEXITY_API_KEY=
PERPLEXITY_DEFAULT_MODEL=sonar-pro
# Pricing (USD per 1M tokens). Only change if Perplexity updates their rates.
PERPLEXITY_INPUT_USD_PER_1M=3
PERPLEXITY_OUTPUT_USD_PER_1M=15
PERPLEXITY_INPUT_USD_PER_1M_BASIC=1
PERPLEXITY_OUTPUT_USD_PER_1M_BASIC=1

# Free RSS discovery for the minimal scout. Comma-separated "Name|URL".
# Leave empty to use the source registry (Phase B default, 10 sources).
SCOUT_OVERSEAS_RSS_FEEDS=
SCOUT_JAPAN_RSS_FEEDS=
# Comma-separated source IDs from registry.ts to disable at runtime.
# Example: SCOUT_DISABLED_SOURCE_IDS=greenfunding,campfire
SCOUT_DISABLED_SOURCE_IDS=
# Phase B: independent limits for raw-per-feed and LLM-evaluated total.
MINIMAL_SCOUT_LIMIT_PER_FEED=20
MINIMAL_SCOUT_LLM_MAX=15
# Legacy combined limit (used only when the two above are unset).
MINIMAL_SCOUT_LIMIT=

# Phase C: staged pipeline settings.
# How many scoring jobs to run concurrently (3 avoids Anthropic rate limits).
SCOUT_SCORING_CONCURRENCY=3

# Product Hunt GraphQL token (developer.producthunt.com → Applications → API).
# Without this, the Product Hunt source returns empty (stub) instead of failing.
PRODUCT_HUNT_TOKEN=

# Optional future local LLM endpoint, not currently wired.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3
