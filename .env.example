# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Postgres connection (use Supabase "Session pooler" URI for app, "Direct" for migrations)
# Direct connection (used by drizzle-kit migrations)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Pooled connection (used by Next.js runtime — IPv4 friendly)
DATABASE_POOL_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Public base URL used in Lark alert links and absolute redirects (no trailing slash)
# Local: http://localhost:3000
# Production example: https://ai-agent-command.vercel.app
NEXT_PUBLIC_APP_URL=https://ai-agent-command.vercel.app/

# Lark (System 8 — budget alerts + daily summary)
# Webhook URL for the #pathway-ops channel custom bot. Leave empty to log to stdout in dev.
LARK_WEBHOOK_URL_OPS=
LARK_WEBHOOK_TIMEOUT_MS=5000

# Budget thresholds (% of agents.daily_budget_usd / monthly_budget_usd).
# Soft: alert only. Hard: alert + reject further runs until next period.
BUDGET_SOFT_THRESHOLD_PCT=80
BUDGET_HARD_THRESHOLD_PCT=100

# LLM provider for runStructured().
# Current implementation: "mock" only for stable production UI.
# Planned implementation: "anthropic" | "openai" | "perplexity".
LLM_PROVIDER=mock

# AI provider keys (required before switching away from mock mode)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.4-mini

# Perplexity (System 7 — domestic research; provider implementation pending)
PERPLEXITY_API_KEY=
PERPLEXITY_DEFAULT_MODEL=sonar-pro

# Data collection / automation (required for full 24/7 agent operation)
APIFY_TOKEN=
APIFY_ACTOR_KS=
APIFY_ACTOR_IGG=
APIFY_ACTOR_BK=
MAKE_API_TOKEN=

# Lark Open Platform / Base sync (planned System 9)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_APP_TOKEN=
LARK_BASE_TABLE_PRODUCTS=
LARK_BASE_TABLE_DECISIONS=

# Optional domestic research providers (Phase 2)
KEEPA_API_KEY=
SELLERSPRITE_API_KEY=

# Optional outreach/email providers (Phase 2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SENDGRID_API_KEY=
POSTMARK_TOKEN=
